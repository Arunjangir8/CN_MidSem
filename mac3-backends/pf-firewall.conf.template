# =====================================================================
#  Firewall rules for Mac 3 (Phase 2, Extension C: Service Isolation)
#  (made by generate-configs.sh from mac3-backends/pf-firewall.conf.template)
#
#  Goal: ONLY Mac 2 (nginx edge, __MAC2_IP__) may connect to the backend
#        ports __BACKEND_A_PORT__ and __BACKEND_B_PORT__. Everyone else is blocked.
#
#  Turn ON :  sudo pfctl -ef ~/Desktop/cn_phase2/mac3-backends/generated/cn-firewall.conf
#  Check   :  sudo pfctl -sr
#  Turn OFF (rollback):
#             sudo pfctl -f /etc/pf.conf
#             sudo pfctl -d
# =====================================================================

# Don't filter traffic from this Mac to itself (loopback).
# (Lets the standby nginx on Mac 3 reach the backends on Mac 3 in Extension E.)
set skip on lo0

# Rule 1: allow Mac 2 (the edge) to reach the backend ports.
pass in quick proto tcp from __MAC2_IP__ to any port { __BACKEND_A_PORT__ __BACKEND_B_PORT__ }

# Rule 2: block EVERYONE ELSE from the backend ports.
# "return" sends back a "connection refused" right away, so the demo is fast.
# (Without "return" the packet is silently dropped and the client waits/times out.)
block return in quick proto tcp from any to any port { __BACKEND_A_PORT__ __BACKEND_B_PORT__ }

# Everything else (DNS port 53, HTTPS port __HTTPS_PORT__, ping, ...) is allowed as normal.
